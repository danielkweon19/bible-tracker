rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validSession() {
      return request.resource.data.keys().hasOnly([
          "uid",
          "durationSeconds",
          "chapters",
          "verseCount",
          "createdAt"
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.durationSeconds is int
        && request.resource.data.durationSeconds > 0
        && request.resource.data.durationSeconds <= 43200
        && request.resource.data.chapters is list
        && request.resource.data.chapters.size() > 0
        && request.resource.data.chapters.size() <= 50
        && request.resource.data.verseCount is int
        && request.resource.data.verseCount > 0
        && request.resource.data.verseCount <= 5000
        && request.resource.data.createdAt == request.time;
    }

    function validReadingState(uid) {
      return request.resource.data.keys().hasOnly([
          "uid",
          "bookIndex",
          "chapterIndex",
          "activeStartedAt",
          "activeStoppedAt",
          "activeChapters",
          "updatedAt"
        ])
        && request.resource.data.uid == uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.bookIndex is int
        && request.resource.data.bookIndex >= 0
        && request.resource.data.bookIndex < 100
        && request.resource.data.chapterIndex is int
        && request.resource.data.chapterIndex >= 0
        && request.resource.data.chapterIndex < 200
        && (request.resource.data.activeStartedAt == null
          || request.resource.data.activeStartedAt is int)
        && (request.resource.data.activeStoppedAt == null
          || request.resource.data.activeStoppedAt is int)
        && request.resource.data.activeChapters is list
        && request.resource.data.activeChapters.size() <= 50
        && request.resource.data.updatedAt == request.time;
    }

    match /readingSessions/{sessionId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && validSession();
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && validSession()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["createdAt"]);
    }

    match /readingStates/{uid} {
      allow read: if signedIn() && uid == request.auth.uid;
      allow create, update: if signedIn() && validReadingState(uid);
      allow delete: if signedIn() && uid == request.auth.uid;
    }
  }
}
